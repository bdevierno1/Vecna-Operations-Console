# Put this file at: vecna-ops/backend/.env (same folder as requirements.txt)
#
# LiteLLM model id (see https://docs.litellm.ai/docs/providers)
# For OpenRouter you MUST set both OPENROUTER_API_KEY and an openrouter/... model id.
# You do not need OPENAI_API_KEY for OpenRouter: the backend mirrors OPENROUTER_API_KEY for LiteLLM.
# LiteLLM model ids use an openrouter/ prefix; the OpenRouter docs show the bare id, e.g.:
#   openrouter/qwen/qwen3.6-plus:free  ->  same as requests body model qwen/qwen3.6-plus:free
# Optional headers (HTTP-Referer / X-Title), same as OpenRouter examples:
#   OPENROUTER_SITE_URL=http://localhost:5173
#   OPENROUTER_APP_NAME=Vecna Ops
# Examples:
#   LITELLM_MODEL_ID=openrouter/qwen/qwen3-235b-a22b-2507
#   LITELLM_MODEL_ID=openai/gpt-4o-mini
LITELLM_MODEL_ID=openai/gpt-4o-mini

# --- OpenRouter (https://openrouter.ai/activity) ---
OPENROUTER_API_KEY=

# Provider keys (set the one matching your model if not using OpenRouter)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# AZURE_API_KEY=
# AWS credentials for Bedrock if using bedrock/ models

# CORS (comma-separated). Electron loading built UI from file:// may send Origin "null" —
# append ,null if API calls from file:// are blocked (see electron/README.md).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Platform pricing (USD, optional; all default to 0 = free on top of LLM tokens) ---
# Per completed scan (one fee when an operation finishes successfully).
# VECNA_SCAN_FEE_USD=0.05
#
# Tool surcharges (separate from token $). Two styles — use one or both:
#
# (A) Legacy: same $ per tool invocation for every tool (simplest).
# VECNA_TOOL_UNIT_FEE_USD=0.01
#
# (B) Tiered: $ per call by family (dns / network / paths / default / premium).
#     Setting any of the JSON vars below enables tiered mode; merge with built-in defaults in app/pricing.py.
# VECNA_TOOL_FAMILY_FEES_JSON={"dns":0.005,"network":0.01,"paths":0.01,"default":0}
#
# Optional: map tool names to a family (defaults already map the three Vecna recon tools).
# VECNA_TOOL_FAMILY_BY_TOOL_JSON={"resolve_dns_and_subdomains":"dns","analyze_http_security_headers":"network","probe_common_paths":"paths"}
#
# Optional: fixed $ per call for a specific tool name (overrides family rate).
# VECNA_TOOL_FEE_OVERRIDES_JSON={"probe_common_paths":0.25}
#
# Hide dollar amounts in the UI (tokens/duration still show).
# VECNA_HIDE_COSTS=false
